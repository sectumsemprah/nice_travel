{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@nice-travel/shared": ["packages/shared/src/index.ts"],
      "@nice-travel/domain": ["packages/domain/src/index.ts"],
      "@nice-travel/providers": ["packages/providers/src/index.ts"]
    }
  }
}

